{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/empresarios", "destination": "/diagnostico-empresarios" },
    { "source": "/empres%C3%A1rios", "destination": "/diagnostico-empresarios" },
    { "source": "/empresários", "destination": "/diagnostico-empresarios" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "diag.pitchcompany.com.br" }],
      "destination": "/empresarios",
      "permanent": false
    },
    {
      "source": "/anamnese-ia",
      "destination": "/anamnese-conteudo",
      "permanent": true
    }
  ]
}
